{%- comment -%}
  문서 사이트 스타일 사이드바: 부모 카테고리 > 자식 카테고리 > 글 목록 트리
  - 지금 보고 있는 글의 카테고리는 서버에서 미리 펼쳐서 렌더링 (data-current)
  - 사용자가 펼치거나 접은 상태는 assets/js/custom.js 가 localStorage 에 기억
  - 대소문자만 다른 카테고리(DataBase / DATABASE 등)는 하나로 합침
  - 카테고리 형식은 "부모" 또는 "부모/자식" (front matter 의 categories)
{%- endcomment -%}

<!-- sum = 사이트의 모든 포스트 개수 -->
{% assign sum = site.posts | size %}

<!-- 지금 보고 있는 글의 카테고리 (자동으로 펼칠 경로) -->
{% assign cur_cat = page.categories | first | default: "" %}
{% assign cur_parts = cur_cat | split: "/" %}
{% assign cur_parent = cur_parts[0] | upcase %}
{% assign cur_child = cur_parts[1] | upcase %}

{% assign parent_categories = "" | split: "" %}   <!-- 부모 카테고리 리스트 (대문자) -->
{% assign category_tree = "" | split: "" %}       <!-- '부모|자식|포스트수|원본이름' 리스트 -->

<!-- 1. 부모 카테고리, 카테고리 정보 저장 -->
{% for category in site.categories %}
  {% assign cat_name = category[0] %}
  {% assign post_count = category[1].size %}
  {% assign cat_parts = cat_name | split: '/' %}
  {% assign parent = cat_parts[0] | upcase %}
  {% assign child = cat_parts[1] | default: "" %}

  {% unless parent_categories contains parent %}
    {% assign parent_categories = parent_categories | push: parent %}
  {% endunless %}

  {% assign tree_item = parent | append: "|" | append: child | append: "|" | append: post_count | append: "|" | append: cat_name %}
  {% assign category_tree = category_tree | push: tree_item %}
{% endfor %}

<!-- 2. 부모별 포스트 수 계산 및 정렬 (포스트 많은 순) -->
{% assign parent_with_count = "" | split: "" %}
{% for parent in parent_categories %}
  {% assign parent_total = 0 %}
  {% for tree_item in category_tree %}
    {% assign parts = tree_item | split: "|" %}
    {% if parts[0] == parent %}
      {% assign parent_total = parent_total | plus: parts[2] %}
    {% endif %}
  {% endfor %}
  {% assign padded_count = parent_total | prepend: "0000" | slice: -4, 4 %}
  {% assign sort_key = padded_count | append: "|" | append: parent | append: "|" | append: parent_total %}
  {% assign parent_with_count = parent_with_count | push: sort_key %}
{% endfor %}
{% assign sorted_parents_data = parent_with_count | sort | reverse %}

<nav class="nav__list docs-nav">
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ site.data.ui-text[site.locale].menu_label }}</label>
  <ul class="nav__items">
    <li class="docs-nav__total">
      Total Posts <span class="taxonomy__count">{{ sum }}</span>
    </li>

    <!-- 3. 부모 카테고리별 렌더링 -->
    {% for parent_data in sorted_parents_data %}
      {% assign parent_info = parent_data | split: "|" %}
      {% assign parent = parent_info[1] %}
      {% assign parent_total = parent_info[2] %}

      <!-- 자식 카테고리(대소문자 무시) 목록과 부모에 바로 붙은 원본 카테고리 모으기 -->
      {% assign child_keys = "" | split: "" %}
      {% assign child_names = "" | split: "" %}
      {% assign direct_names = "" | split: "" %}
      {% for tree_item in category_tree %}
        {% assign parts = tree_item | split: "|" %}
        {% if parts[0] == parent %}
          {% if parts[1] == "" %}
            {% assign direct_names = direct_names | push: parts[3] %}
          {% else %}
            {% assign ckey = parts[1] | upcase %}
            {% unless child_keys contains ckey %}
              {% assign child_keys = child_keys | push: ckey %}
              {% assign child_names = child_names | push: parts[1] %}
            {% endunless %}
          {% endif %}
        {% endif %}
      {% endfor %}

      <!-- 자식 카테고리별 포스트 수 합산 후 포스트 많은 순 정렬 -->
      {% assign children_list = "" | split: "" %}
      {% for ckey in child_keys %}
        {% assign cname = child_names[forloop.index0] %}
        {% assign ctotal = 0 %}
        {% for tree_item in category_tree %}
          {% assign parts = tree_item | split: "|" %}
          {% assign pkey = parts[1] | upcase %}
          {% if parts[0] == parent and pkey == ckey %}
            {% assign ctotal = ctotal | plus: parts[2] %}
          {% endif %}
        {% endfor %}
        {% assign padded = ctotal | prepend: "0000" | slice: -4, 4 %}
        {% assign child_data = padded | append: "|" | append: cname | append: "|" | append: ctotal | append: "|" | append: ckey %}
        {% assign children_list = children_list | push: child_data %}
      {% endfor %}
      {% assign sorted_children = children_list | sort | reverse %}

      {% assign parent_id = parent | slugify | prepend: "nav-" %}
      <!-- 카테고리 아이콘 (_data/category_icons.yml) -->
      {% assign cat_icon = site.data.category_icons[parent] | default: site.data.category_icons._default %}
      <li>
        <details class="docs-nav__group" data-nav-id="{{ parent_id }}"{% if parent == cur_parent %} open data-current{% endif %}>
          <summary class="nav__sub-title">
            <span class="docs-nav__caret" aria-hidden="true"></span>
            {% if cat_icon %}<i class="docs-nav__icon fa-fw {{ cat_icon.icon }}" style="color: {{ cat_icon.color }}" aria-hidden="true"></i>{% endif %}
            <span class="docs-nav__label">{{ parent }}</span>
            <span class="taxonomy__count">{{ parent_total }}</span>
          </summary>
          <ul class="docs-nav__children">
            {% for child_data in sorted_children %}
              {% assign child_info = child_data | split: "|" %}
              {% assign cname = child_info[1] %}
              {% assign ctotal = child_info[2] %}
              {% assign ckey = child_info[3] %}

              <!-- 이 자식 노드에 해당하는 원본 카테고리 이름들 -->
              {% assign child_orig_names = "" | split: "" %}
              {% for tree_item in category_tree %}
                {% assign parts = tree_item | split: "|" %}
                {% assign pkey = parts[1] | upcase %}
                {% if parts[0] == parent and pkey == ckey %}
                  {% assign child_orig_names = child_orig_names | push: parts[3] %}
                {% endif %}
              {% endfor %}

              {% assign child_id = parent | append: "-" | append: cname | slugify | prepend: "nav-" %}
              <li>
                <details class="docs-nav__group docs-nav__group--child" data-nav-id="{{ child_id }}"{% if parent == cur_parent and ckey == cur_child %} open data-current{% endif %}>
                  <summary class="docs-nav__child-title">
                    <span class="docs-nav__caret" aria-hidden="true"></span>
                    <span class="docs-nav__label">{{ cname }}</span>
                    <span class="taxonomy__count">{{ ctotal }}</span>
                  </summary>
                  <ul class="docs-nav__posts">
                    {% include nav_list_posts.html names=child_orig_names %}
                  </ul>
                </details>
              </li>
            {% endfor %}

            <!-- 자식 없이 부모 카테고리에 바로 속한 글 -->
            {% include nav_list_posts.html names=direct_names %}
          </ul>
        </details>
      </li>
    {% endfor %}
  </ul>
</nav>
